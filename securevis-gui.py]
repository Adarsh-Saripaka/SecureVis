#!/usr/bin/env python3
import json
import time
import psutil
from textual.app import App, ComposeResult
from textual.widgets import Header, Footer, Static, DataTable, Label
from textual.containers import Container, Horizontal
from rich.text import Text

DATA_FILE = "/tmp/securevis_data.json"

class Dashboard(App):
    """SecureVis Interactive Dashboard"""
    TITLE = "SecureVis System Visualizer"
    CSS_PATH = None

    def compose(self) -> ComposeResult:
        yield Header()
        with Container():
            yield Label("🔐 SecureVis Real-Time System Visualizer", id="title")
            yield Label("", id="stats")  # dynamic stats area
            self.table = DataTable(id="process_table")
            yield self.table
        yield Footer()

    def on_mount(self):
        # Initialize table and periodic refresh
        self.table.add_columns("PID", "Name", "CPU%", "MEM%")
        self.set_interval(2, self.refresh_data)

    def refresh_data(self):
        """Refresh live data from /tmp/securevis_data.json"""
        try:
            with open(DATA_FILE) as f:
                data = json.load(f)
        except FileNotFoundError:
            self.query_one("#stats", Label).update("⚠️ Waiting for data... (run securevis-collector.py)")
            return
        except Exception as e:
            self.query_one("#stats", Label).update(f"Error: {e}")
            return

        # Update stats section
        cpu, mem, disk = data.get("cpu", 0), data.get("memory", 0), data.get("disk", 0)
        stats_text = Text(f"CPU: {cpu:.1f}%   MEM: {mem:.1f}%   DISK: {disk:.1f}%", style="bold cyan")
        self.query_one("#stats", Label).update(stats_text)

        # Update process table
        self.table.clear()
        for proc in sorted(data["processes"], key=lambda p: p["cpu"], reverse=True)[:10]:
            self.table.add_row(str(proc["pid"]), proc["name"], f"{proc['cpu']:.1f}", f"{proc['mem']:.1f}")

if __name__ == "__main__":
    Dashboard().run()
